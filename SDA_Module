import torch
import torch.nn as nn
import torch.nn.functional as F

class GradientReverse(torch.autograd.Function):
    @staticmethod
    def forward(ctx, x, lambd):
        ctx.lambd = lambd
        return x

    @staticmethod
    def backward(ctx, grad):
        return -ctx.lambd * grad, None

def grl(x, lambd=1.0):
    return GradientReverse.apply(x, lambd)

class CondDisc(nn.Module):
    """
    Conditional discriminator that takes feature + condition (prediction or domain label)
    as input and outputs domain logits.
    """
    def __init__(self, feat_ch=1024, n_class=1):
        super().__init__()
        self.conv = nn.Sequential(
            nn.Conv2d(feat_ch + n_class, 256, 3, 1, 1),
            nn.ReLU(inplace=True),
            nn.Conv2d(256, 1, 3, 1, 1)
        )

    def forward(self, feat, cond):
        # cond: [B, n_class, H_cond, W_cond]
        cond_map = F.adaptive_avg_pool2d(cond, feat.shape[2:])
        x = torch.cat([feat, cond_map], dim=1)
        out = self.conv(x)
        # output [B,1,H,W] -> global average pooling -> [B,1]
        out = F.adaptive_avg_pool2d(out, 1).view(out.size(0), 1)
        return out


class SDA_Module(nn.Module):
    """
    Sub-domain Adaptation module.
    Can be directly inserted into the network to operate on feature maps.
    """
    def __init__(self, in_channels=1024):
        super().__init__()
        self.in_channels = in_channels
        self.disc = CondDisc(feat_ch=in_channels, n_class=1)

    def forward(self, feat, lambd=0.1, cond=None):
        """
        feat: [B, C, H, W] input feature
        lambd: gradient reversal coefficient
        cond: condition tensor, can be pred or domain_label
        Returns:
            feat_grl: feature after GRL (used by decoder during training)
            dom_out: conditional discriminator output logits [B,1]
        """
        feat_grl = grl(feat, lambd)
        if cond is None:
            # if no condition is given, use zeros
            cond = torch.zeros(feat.size(0), 1, 1, 1).to(feat.device)
        dom_out = self.disc(feat_grl, cond)
        return feat_grl, dom_out

if __name__ == '__main__':
    x = torch.randn(2, 1024, 32, 32)
    cond = torch.randn(2, 1, 8, 8)
    sda = SDA_Module(in_channels=1024)
    feat_grl, dom_out = sda(x, lambd=0.5, cond=cond)
    print("feat_grl:", feat_grl.shape)  # [B, C, H, W]
    print("dom_out:", dom_out.shape)    # [B, 1]
